# ──────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — diese Werte gehören in .env  (NICHT committen)
# Der Publishable/Anon-Key ist client-seitig und öffentlich (wird im Bundle
# ausgeliefert). Nur öffentliche Reads/erlaubte Writes darüber.
# ──────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-(anon)-key>

# Step-2-Verfügbarkeit über die Edge Function (Google-Kalender) beziehen.
# false/leer = Frontend rechnet die Slots übergangsweise selbst aus den
# Öffnungszeiten (availability_rules) — bis die Function `available-slots`
# deployt ist. Danach auf true stellen.
VITE_USE_EDGE_AVAILABILITY=false

# ──────────────────────────────────────────────────────────────────────────
# Supabase Edge Functions — als SECRETS setzen, NICHT ins Frontend/.env:
#   npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY werden von
#  der Plattform automatisch in Edge Functions bereitgestellt — hier nicht nötig.)
# ──────────────────────────────────────────────────────────────────────────

# Google Calendar — Quelle für freie Slots in Step 2 ("Termin finden").
# Empfehlung: Google-Cloud Service-Account anlegen und Nadines Kalender für
# dessen E-Mail mit Leserechten freigeben. Alternativ OAuth-Refresh-Token.
GOOGLE_CALENDAR_ID=<z.B. nadine@gmail.com  ODER  ...@group.calendar.google.com>
GOOGLE_SERVICE_ACCOUNT_EMAIL=<name>@<project>.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Zeitzone für Slot-Berechnung (Öffnungszeiten/Busy-Abgleich)
BOOKING_TIMEZONE=Europe/Berlin

# Resend — transaktionale E-Mails (Buchungsanfrage-Eingang / Bestätigung / Storno)
RESEND_API_KEY=<resend-api-key>
RESEND_FROM="Nady's Wohlfühloase <buchung@deine-domain.de>"
